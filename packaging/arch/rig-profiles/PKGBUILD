# Maintainer: Karasowl <ismaelguimarais@gmail.com>
pkgname=rig-profiles
pkgver=0.1.0
pkgrel=1
pkgdesc="quiet/balanced/performance profiles for CPU (governor+EPP) and NVIDIA GPU (power limit)"
arch=('any')
url="https://github.com/Karasowl/linux-rig-tools"
license=('GPL-3.0-or-later')
depends=('bash')
optdepends=('nvidia-utils: GPU power-limit profiles')
source=("linux-rig-tools-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "linux-rig-tools-$pkgver"
  install -Dm755 "tools/$pkgname/bin/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "tools/$pkgname/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
