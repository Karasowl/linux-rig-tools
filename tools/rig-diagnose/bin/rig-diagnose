#!/usr/bin/env bash
# rig-diagnose — inventory RGB / fan / cooling controllers and report their
# Linux support status. Read-only: it never writes to any device.
# Part of https://github.com/Karasowl/linux-rig-tools
set -u

VERSION="0.1.0"

case "${1:-}" in
  --version) echo "rig-diagnose $VERSION"; exit 0 ;;
  -h|--help)
    echo "usage: rig-diagnose [--version]"
    echo "Prints a markdown hardware report to stdout. Attach it to issues at:"
    echo "https://github.com/Karasowl/linux-rig-tools/issues"
    exit 0 ;;
esac

say() { printf '%s\n' "$*"; }
section() { printf '\n## %s\n\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

say "# rig-diagnose report"
say ""
say "- date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
say "- kernel: $(uname -r)"
if [[ -r /etc/os-release ]]; then
  say "- distro: $(. /etc/os-release && echo "${PRETTY_NAME:-unknown}")"
fi

section "System"
for f in sys_vendor product_name board_vendor board_name bios_version; do
  v=$(cat "/sys/class/dmi/id/$f" 2>/dev/null || true)
  [[ -n "$v" ]] && say "- $f: $v"
done
say "- cpu: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ //')"
say "- cpufreq: driver=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null || echo n/a), governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"

section "GPU"
if have lspci; then
  lspci -nn | grep -Ei 'vga|3d controller' | sed 's/^/- /'
fi
if have nvidia-smi; then
  say ""
  nvidia-smi --query-gpu=name,driver_version,power.limit,power.default_limit,power.max_limit \
    --format=csv 2>/dev/null | sed 's/^/    /' || say "nvidia-smi present but query failed"
fi

section "USB devices"
if have lsusb; then
  lsusb | grep -v 'root hub' | sed 's/^/- /'
else
  say "usbutils not installed (install it: pacman -S usbutils / apt install usbutils)"
fi

section "HID raw nodes"
found=0
for h in /sys/class/hidraw/hidraw*; do
  [[ -e "$h" ]] || continue
  found=1
  name=$(grep -h 'HID_NAME=' "$h/device/uevent" 2>/dev/null | cut -d= -f2-)
  id=$(grep -h 'HID_ID=' "$h/device/uevent" 2>/dev/null | cut -d= -f2-)
  node="/dev/${h##*/}"
  acc="no user access"
  [[ -r "$node" && -w "$node" ]] && acc="user read-write"
  say "- ${h##*/}: $name ($id) [$acc]"
done
[[ $found -eq 0 ]] && say "none"

section "Sensors (hwmon)"
for d in /sys/class/hwmon/hwmon*; do
  [[ -e "$d" ]] || continue
  say "- ${d##*/}: $(cat "$d/name" 2>/dev/null)"
done
fanpwm=$(ls /sys/class/hwmon/hwmon*/pwm[0-9] 2>/dev/null | wc -l)
say ""
say "PWM fan channels exposed to Linux: $fanpwm"
if [[ "$fanpwm" -eq 0 ]]; then
  say "(0 means your fan headers sit behind a USB controller or are BIOS-only —"
  say "exactly the problem linux-rig-tools works on)"
fi

section "linux-rig-tools target devices detected"
if have lsusb; then
  hits=0
  check() {
    if [[ -n "$(lsusb -d "$1" 2>/dev/null)" ]]; then
      say "- \`$1\` $2 — $3"
      hits=1
    fi
  }
  check 1e71:2023 "NZXT N9 Z890 embedded fan/RGB controller" "no upstream support yet → tools/nzxt-n9"
  check 2516:0232 "Cooler Master MasterLiquid Core Nex Digital" "no upstream support yet → tools/cm-nex-digital"
  check ff00:020c "Chassis LED-matrix controller ('309')" "no upstream support yet → tools/chassis-ledmatrix"
  check 26ce:0a09 "Chassis USB screen/audio composite" "under investigation → tools/chassis-ledmatrix"
  check 320f:5000 "Evision RGB keyboard family" "partial support in OpenRGB (check openrgb.org/devices.html)"
  [[ $hits -eq 0 ]] && say "none of the currently tracked devices — open an issue with this report to add yours!"
else
  say "lsusb unavailable, cannot match"
fi

say ""
say "---"
say "Report generated by rig-diagnose $VERSION — https://github.com/Karasowl/linux-rig-tools"
