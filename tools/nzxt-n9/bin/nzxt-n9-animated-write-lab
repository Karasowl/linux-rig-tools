#!/usr/bin/env python3
"""Closed CLI for exact NZXT N9 Spectrum Wave D35 and Fixed D32 restore."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

TOOL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TOOL_ROOT / "lib"))

from nzxt_n9_animated import (  # noqa: E402
    APPLY_CONFIRM_TOKEN,
    RESTORE_CONFIRM_TOKEN,
    OfflineSpectrumWaveD35Writer,
    SpectrumWaveD35Writer,
    offline_restore_d32,
    real_restore_d32,
)
from nzxt_n9_fixed import N9FixedError  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="nzxt-n9-animated-write-lab",
        description=(
            "Closed laboratory for the exact captured D35 Spectrum Wave frame "
            "and typed D32 Fixed restoration. This is not a general 2a 04 "
            "specification and does not replace physical QA."
        ),
    )
    parser.add_argument(
        "--offline",
        action="store_true",
        help="validate frozen operations without resolving, opening or writing hidraw",
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser(
        "preflight",
        help="check the exact frame and, unless offline, target readiness without opening hidraw",
    )
    apply_parser = commands.add_parser(
        "apply-spectrum-wave",
        help="send exactly one frozen D35 frame with no commit, sleep or retry",
    )
    apply_parser.add_argument("confirmation")
    restore_parser = commands.add_parser(
        "restore-d32",
        help="delegate restoration to the existing typed Fixed D32 transaction",
    )
    restore_parser.add_argument("confirmation")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "preflight":
            if args.offline:
                result = OfflineSpectrumWaveD35Writer().preflight()
                print("OK: %s" % result.detail)
            else:
                readiness = SpectrumWaveD35Writer().preflight()
                print(
                    "OK: %s, CPU Package %.1f C, hidraw was not opened"
                    % (readiness.node, readiness.temperature_c)
                )
            return 0

        if args.command == "apply-spectrum-wave":
            if args.confirmation != APPLY_CONFIRM_TOKEN:
                parser.error(
                    "apply-spectrum-wave requires the exact token %s"
                    % APPLY_CONFIRM_TOKEN
                )
            result = (
                OfflineSpectrumWaveD35Writer().apply()
                if args.offline
                else SpectrumWaveD35Writer().apply()
            )
            print("OK: %s" % result.detail)
            return 0

        if args.command == "restore-d32":
            if args.confirmation != RESTORE_CONFIRM_TOKEN:
                parser.error(
                    "restore-d32 requires the exact token %s"
                    % RESTORE_CONFIRM_TOKEN
                )
            result = offline_restore_d32() if args.offline else real_restore_d32()
            print("OK: %s" % result.detail)
            return 0
    except (N9FixedError, ValueError) as exc:
        print("error: %s" % exc, file=sys.stderr)
        return 1

    parser.error("unsupported command")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
