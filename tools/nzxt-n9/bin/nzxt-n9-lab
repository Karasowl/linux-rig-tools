#!/usr/bin/env python3
"""Utilitarian PyQt6 laboratory for NZXT N9 Fixed per-zone colour vectors."""
from __future__ import annotations

import argparse
import sys
from enum import Enum
from pathlib import Path

LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from PyQt6.QtCore import QObject, QRegularExpression, QThread, Qt, pyqtSignal
from PyQt6.QtGui import QColor, QRegularExpressionValidator
from PyQt6.QtWidgets import (
    QApplication, QColorDialog, QFormLayout, QGridLayout, QGroupBox,
    QHBoxLayout, QLabel, QLineEdit, QMainWindow, QPushButton, QSlider,
    QSpinBox, QTextEdit, QVBoxLayout, QWidget,
)

from nzxt_n9_fixed import (
    FailureKind, N9FixedError, N9FixedWriter, OfflineWriter, Readiness,
    SendResult, ZoneVector, failure_kind, parse_hex_color, read_only_readiness,
    restore_d32_vector,
)


class DeviceState(Enum):
    OFFLINE = "offline"
    ABSENT = "dispositivo ausente"
    THERMAL = "bloqueo térmico"
    READY = "listo"
    WRITING = "escribiendo"
    ERROR = "error"


class ZoneButton(QPushButton):
    def __init__(self, number: int, click_callback) -> None:
        super().__init__(str(number))
        self.number = number
        self._click_callback = click_callback
        self.setToolTip("Zona %d" % number)
        self.setMinimumSize(35, 29)

    def mousePressEvent(self, event) -> None:  # noqa: N802, Qt API
        if event.button() == Qt.MouseButton.LeftButton:
            self._click_callback(self.number - 1, bool(event.modifiers() & Qt.KeyboardModifier.ControlModifier))
            event.accept()
            return
        super().mousePressEvent(event)


class OperationWorker(QObject):
    """Owns all slow D32 extraction and writer calls outside the GUI thread."""
    succeeded = pyqtSignal(str, object, object)
    failed = pyqtSignal(str, str, str)

    def __init__(self, operation: str, writer, vector: ZoneVector | None, d32_loader, readiness_reader) -> None:
        super().__init__()
        self.operation = operation
        self.writer = writer
        self.vector = vector
        self.d32_loader = d32_loader
        self.readiness_reader = readiness_reader

    def run(self) -> None:
        try:
            if self.operation == "readiness":
                readiness = self.readiness_reader()
                self.succeeded.emit(self.operation, None, SendResult(False, "%s, CPU Package %.1f C" % (readiness.node, readiness.temperature_c)))
                return
            if self.operation == "d32":
                try:
                    loaded = self.d32_loader()
                except Exception as exc:
                    self.failed.emit(self.operation, FailureKind.D32_LOAD.value, str(exc))
                    return
                vector = ZoneVector.from_frame(loaded) if isinstance(loaded, bytes) else loaded
            else:
                if self.vector is None:
                    raise N9FixedError("missing prepared zone vector")
                vector = self.vector
            result = self.writer.send_vector(vector)
            if isinstance(result, str):  # Compatibility for deliberately simple test fakes.
                result = SendResult(False, result)
            self.succeeded.emit(self.operation, vector, result)
        except Exception as exc:  # result is rendered safely by the GUI state machine
            self.failed.emit(self.operation, failure_kind(exc).value, str(exc))


class FixedLabWindow(QMainWindow):
    def __init__(
        self,
        offline: bool,
        *,
        writer=None,
        d32_loader=restore_d32_vector,
        readiness_reader=read_only_readiness,
    ) -> None:
        super().__init__()
        self.offline = offline
        self.writer = writer if writer is not None else (OfflineWriter() if offline else N9FixedWriter())
        self.d32_loader = d32_loader
        self.readiness_reader = readiness_reader
        self.prepared_vector = ZoneVector.from_rgb([(255, 255, 255)] * 49, 25)
        self.last_success_vector: ZoneVector | None = None
        self.last_success_description = "ninguno"
        self.last_offline_validation: ZoneVector | None = None
        self.last_offline_validation_description = "ninguna"
        self.physical_unknown = True
        self.selected: set[int] = set()
        self.device_state = DeviceState.OFFLINE if offline else DeviceState.ERROR
        self.busy = False
        self._thread: QThread | None = None
        self._worker: OperationWorker | None = None
        self._closing_requested = False
        self._state_before_operation = self.device_state
        self.setWindowTitle("nzxt-n9-lab: Fixed per-zone laboratory")
        self.resize(850, 660)
        self._build_ui()
        self._update_ui()
        if offline:
            self._log("Modo offline: se validan vectores, nunca se abre hidraw.")
        else:
            self._start_operation("readiness")

    def _build_ui(self) -> None:
        root = QWidget()
        layout = QHBoxLayout(root)
        map_box = QGroupBox("Recorrido confirmado: 1-17 izquierda, 18-34 abajo, 35-49 derecha")
        grid = QGridLayout(map_box)
        self.zone_buttons: list[ZoneButton] = []
        for zone in range(49):
            button = ZoneButton(zone + 1, self._zone_clicked)
            self.zone_buttons.append(button)
            if zone < 17:
                grid.addWidget(button, zone, 0)
            elif zone < 34:
                grid.addWidget(button, 17, zone - 16)
            else:
                grid.addWidget(button, zone - 33, 17)
        layout.addWidget(map_box, 2)

        panel = QVBoxLayout()
        self.device_label = QLabel()
        self.outcome_label = QLabel()
        self.map_state_label = QLabel()
        self.map_state_label.setWordWrap(True)
        panel.addWidget(self.device_label)
        panel.addWidget(self.outcome_label)
        panel.addWidget(self.map_state_label)

        selection_row = QHBoxLayout()
        self.all_button = QPushButton("Seleccionar todas")
        self.clear_button = QPushButton("Limpiar selección")
        self.all_button.clicked.connect(self._select_all)
        self.clear_button.clicked.connect(self._clear_selection)
        selection_row.addWidget(self.all_button)
        selection_row.addWidget(self.clear_button)
        panel.addLayout(selection_row)

        color_row = QHBoxLayout()
        self.color_button = QPushButton("Elegir color…")
        self.color_button.clicked.connect(self._choose_color)
        self.hex_input = QLineEdit("FFFFFF")
        self.hex_input.setMaxLength(6)
        self.hex_input.setValidator(QRegularExpressionValidator(QRegularExpression("[0-9A-Fa-f]{6}")))
        self.hex_input.textChanged.connect(self._update_ui)
        color_row.addWidget(self.color_button)
        color_row.addWidget(self.hex_input)
        panel.addLayout(color_row)

        brightness_form = QFormLayout()
        self.brightness_slider = QSlider(Qt.Orientation.Horizontal)
        self.brightness_slider.setRange(0, 100)
        self.brightness_slider.setValue(25)
        self.brightness_spin = QSpinBox()
        self.brightness_spin.setRange(0, 100)
        self.brightness_spin.setValue(25)
        self.brightness_slider.valueChanged.connect(self.brightness_spin.setValue)
        self.brightness_spin.valueChanged.connect(self.brightness_slider.setValue)
        brightness_form.addRow("Brillo para zonas seleccionadas", self.brightness_slider)
        brightness_form.addRow("Porcentaje", self.brightness_spin)
        panel.addLayout(brightness_form)

        self.apply_button = QPushButton("Aplicar")
        self.restore_button = QPushButton("Restaurar D32")
        self.check_button = QPushButton("Comprobar dispositivo")
        self.apply_button.clicked.connect(self._apply)
        self.restore_button.clicked.connect(self._restore_d32)
        self.check_button.clicked.connect(lambda: self._start_operation("readiness"))
        panel.addWidget(self.apply_button)
        panel.addWidget(self.restore_button)
        panel.addWidget(self.check_button)
        self.log = QTextEdit()
        self.log.setReadOnly(True)
        self.log.setMinimumHeight(170)
        panel.addWidget(QLabel("Registro"))
        panel.addWidget(self.log, 1)
        layout.addLayout(panel, 3)
        self.setCentralWidget(root)

    def _log(self, text: str) -> None:
        self.log.append(text)

    def _selection_text(self) -> str:
        if not self.selected:
            return "sin selección"
        if len(self.selected) == 1:
            return "selección simple"
        if len(self.selected) == 49:
            return "todas las zonas"
        return "selección múltiple (%d)" % len(self.selected)

    def _zone_clicked(self, zone: int, multi: bool) -> None:
        if self.busy:
            return
        if multi:
            self.selected.symmetric_difference_update({zone})
        else:
            self.selected = {zone}
        self._update_ui()

    def _select_all(self) -> None:
        if not self.busy:
            self.selected = set(range(49))
            self._update_ui()

    def _clear_selection(self) -> None:
        if not self.busy:
            self.selected.clear()
            self._update_ui()

    def _choose_color(self) -> None:
        initial = QColor("#" + self.hex_input.text()) if self._hex_color() else QColor("#ffffff")
        color = QColorDialog.getColor(initial, self, "Elegir color RGB")
        if color.isValid():
            self.hex_input.setText(color.name(QColor.NameFormat.HexRgb)[1:].upper())

    def _hex_color(self):
        try:
            return parse_hex_color(self.hex_input.text())
        except ValueError:
            return None

    def _can_write(self) -> bool:
        return self.device_state in {DeviceState.OFFLINE, DeviceState.READY} and not self.busy

    def _start_operation(self, operation: str, vector: ZoneVector | None = None) -> bool:
        if self.busy or self._thread is not None:
            self._log("Operación rechazada: ya existe una operación en curso.")
            return False
        if operation != "readiness" and not self._can_write():
            self._log("Operación rechazada: el dispositivo no está listo.")
            return False
        self.busy = True
        self._state_before_operation = self.device_state
        self.device_state = DeviceState.WRITING
        self.outcome_label.setText("Última operación: escribiendo")
        self._update_ui()
        self._thread = QThread(self)
        self._worker = OperationWorker(operation, self.writer, vector, self.d32_loader, self.readiness_reader)
        self._worker.moveToThread(self._thread)
        self._thread.started.connect(self._worker.run)
        self._worker.succeeded.connect(self._operation_succeeded)
        self._worker.failed.connect(self._operation_failed)
        self._worker.succeeded.connect(lambda *_args: self._thread.quit() if self._thread else None)
        self._worker.failed.connect(lambda *_args: self._thread.quit() if self._thread else None)
        self._thread.finished.connect(self._worker.deleteLater)
        self._thread.finished.connect(self._thread.deleteLater)
        self._thread.finished.connect(self._thread_finished)
        self._thread.start()
        return True

    def _operation_succeeded(self, operation: str, vector: object, result: object) -> None:
        self.busy = False
        assert isinstance(result, SendResult)
        if operation == "readiness":
            self.device_state = DeviceState.READY
            self.outcome_label.setText("Última comprobación: listo")
            self._log("Preflight read-only: %s" % result.detail)
        else:
            assert isinstance(vector, ZoneVector)
            self.prepared_vector = vector
            self.physical_unknown = True
            self.device_state = DeviceState.OFFLINE if self.offline else DeviceState.READY
            description = "D32 exacto" if operation == "d32" else "Aplicar"
            if result.physical:
                self.last_success_vector = vector
                self.last_success_description = description
                self.outcome_label.setText("Último envío físico: éxito (%s)" % description)
                self._log("ÉXITO FÍSICO %s: %s" % (description, result.detail))
            else:
                self.last_offline_validation = vector
                self.last_offline_validation_description = description
                self.outcome_label.setText("Última validación offline: éxito (%s)" % description)
                self._log("VALIDACIÓN OFFLINE %s: %s" % (description, result.detail))
        self._update_ui()

    def _operation_failed(self, operation: str, kind: str, message: str) -> None:
        self.busy = False
        failure = FailureKind(kind)
        if failure == FailureKind.D32_LOAD:
            self.device_state = self._state_before_operation
        elif failure == FailureKind.LOCK_BUSY:
            self.device_state = self._state_before_operation
        elif failure == FailureKind.THERMAL:
            self.device_state = DeviceState.THERMAL
        elif failure == FailureKind.DEVICE:
            self.device_state = DeviceState.ABSENT
        else:
            self.device_state = DeviceState.ERROR
        if failure == FailureKind.LOCK_BUSY:
            self.outcome_label.setText("Última operación: ocupación (%s)" % operation)
        else:
            self.outcome_label.setText("Última operación: error %s (%s)" % (kind, operation))
        self._log("ERROR etapa=%s tipo=%s: %s" % (operation, kind, message))
        self._update_ui()

    def _thread_finished(self) -> None:
        self._worker = None
        self._thread = None
        if self._closing_requested:
            self.close()

    def _apply(self) -> None:
        color = self._hex_color()
        if not self.selected:
            self._log("No se envió nada: selecciona una o más zonas.")
            return
        if color is None:
            self._log("No se envió nada: RGB debe ser RRGGBB.")
            return
        candidate = self.prepared_vector.with_rgb(self.selected, color, self.brightness_spin.value())
        self.prepared_vector = candidate
        self._start_operation("apply", candidate)

    def _restore_d32(self) -> None:
        self._start_operation("d32")

    def _update_ui(self) -> None:
        if self.device_state == DeviceState.OFFLINE:
            self.device_label.setText("Dispositivo: offline, cero escrituras")
        elif self.device_state == DeviceState.READY:
            self.device_label.setText("Dispositivo: listo")
        elif self.device_state == DeviceState.ABSENT:
            self.device_label.setText("Dispositivo: ausente o no válido")
        elif self.device_state == DeviceState.THERMAL:
            self.device_label.setText("Dispositivo: bloqueo térmico, temperatura no disponible o >=85 C")
        elif self.device_state == DeviceState.WRITING:
            self.device_label.setText("Dispositivo: escribiendo")
        else:
            self.device_label.setText("Dispositivo: error, requiere comprobación manual")
        last = self.last_success_description if self.last_success_vector is not None else "ninguno"
        validation = self.last_offline_validation_description if self.last_offline_validation is not None else "ninguna"
        physical = "desconocido, no confirmado físicamente" if self.physical_unknown else "no disponible"
        self.map_state_label.setText(
            "Preparado: vector raw de 49 triples. Último envío físico: %s. "
            "Última validación offline: %s. Físico: %s. %s"
            % (last, validation, physical, self._selection_text())
        )
        color_valid = self._hex_color() is not None
        controls = not self.busy
        apply_enabled = self._can_write() and bool(self.selected) and color_valid
        for index, button in enumerate(self.zone_buttons):
            red, green, blue = self.prepared_vector.display_rgb(index)
            selected = index in self.selected
            luminance = (red * 299 + green * 587 + blue * 114) / 1000
            foreground = "#000" if luminance > 150 else "#fff"
            border = "3px solid #ff9800" if selected else "1px solid #666"
            button.setStyleSheet("background:#%02x%02x%02x;color:%s;border:%s;" % (red, green, blue, foreground, border))
            button.setEnabled(controls)
        self.all_button.setEnabled(controls)
        self.clear_button.setEnabled(controls)
        self.color_button.setEnabled(controls)
        self.hex_input.setEnabled(controls)
        self.brightness_slider.setEnabled(controls)
        self.brightness_spin.setEnabled(controls)
        self.apply_button.setEnabled(apply_enabled)
        self.restore_button.setEnabled(self._can_write())
        self.check_button.setEnabled(controls and not self.offline)

    def closeEvent(self, event) -> None:  # noqa: N802, Qt API
        if self._thread is not None:
            self._closing_requested = True
            self._log("Cierre diferido: se espera el final seguro de la operación actual.")
            event.ignore()
            return
        event.accept()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="N9 Fixed per-zone laboratory")
    parser.add_argument("--offline", action="store_true", help="validate frames without opening hidraw")
    args = parser.parse_args(argv)
    application = QApplication(["nzxt-n9-lab"])
    window = FixedLabWindow(args.offline)
    window.show()
    return application.exec()


if __name__ == "__main__":
    raise SystemExit(main())
